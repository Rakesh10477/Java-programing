import java.util.Scanner;

public class EmployeeAttendance {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int empId = sc.nextInt();
        String empName = sc.next();
        int[] attendance = new int[7];

        int presentDays = 0;
        boolean invalidInput = false;

        for (int i = 0; i < 7; i++) {
            attendance[i] = sc.nextInt();
            if (attendance[i] != 0 && attendance[i] != 1) {
                invalidInput = true;
            } else if (attendance[i] == 1) {
                presentDays++;
            }
        }

        if (invalidInput) {
            System.out.println("Invalid Attendance Input");
        } else {
            double percentage = (presentDays / 7.0) * 100;
            int absentDays = 7 - presentDays;
            System.out.printf("Attendance = %.2f%%, Absent Days = %d, ", percentage, absentDays);
            if (percentage >= 90.0) {
                System.out.println("Eligible");
            } else {
                System.out.println("Not Eligible");
            }
        }

        sc.close();
    }
}
